# Secrets and tokens only. Never put these in joshua.yaml.
# Copy this file to .env, then run `make init-env`.
#
# `make init-env` appends one line for each secret below that .env does not
# already set, each value from:
#   openssl rand -base64 33 | tr '+/' '-_' | tr -d '='
#
# Minted by `make init-env` (do not set them here):
#   POSTGRES_PASSWORD        Postgres password, also used in core's DATABASE_URL
#   JOSHUA_TOKEN_CHANNELS    fleet token — channels identity
#   JOSHUA_TOKEN_CORE        fleet token — core identity
#   JOSHUA_TOKEN_GATEWAY     fleet token — gateway identity
#   JOSHUA_TOKEN_LAPTOP      fleet token — laptop operator identity

# --- Agent backend ---------------------------------------------------------
# core reads AGENT_BACKEND. docker-compose defaults it to `sdk`. Set `stub` to
# boot the whole system with no Anthropic token.
#AGENT_BACKEND=sdk

# core reaches the Claude Agent SDK with this token. Get one with
# `claude setup-token`. Leave empty when AGENT_BACKEND=stub.
CLAUDE_CODE_OAUTH_TOKEN=

# Shadow switch. Set `1` to make core process real traffic but send
# nothing: the deliverer logs each reply and returns without calling channels.
#DELIVER_DRY_RUN=1

# --- Version -----------------------------------------------------------------
# The release of the three images compose runs. `make init-env` writes this
# line into your .env, so your installation stays on one release until you
# change it here. A `git pull` cannot move you to another version.
#
# To update: put the version you want below, then `make pull && make up`.
# The releases are at https://github.com/jakehigg/joshua-ai/releases
JOSHUA_VERSION=0.0.4

# --- Logging ----------------------------------------------------------------
# Log level for all three containers. One of DEBUG, INFO, WARNING, ERROR.
# The default is INFO. Each container writes one JSON line per record.
#LOG_LEVEL=INFO

# --- Gateway -----------------------------------------------------------------
# Root of the data volume the files MCP confines every path to. Fixed at /data in
# every container; override only for a local test run.
#JOSHUA_DATA_DIR=/data

# --- Viewer -----------------------------------------------------------------
# The read-only web viewer signs a person in with HTTP basic. One variable
# carries every password, as a comma-separated list of `<person-id>=<value>`
# pairs, so no tracked file names a person. A value that starts with `$2` is a
# bcrypt hash; any other value is a literal password, which cannot hold a
# comma. Make a hash with:
#   docker compose run --rm --no-deps -T --entrypoint python core -c \
#     "import bcrypt,getpass;print(bcrypt.hashpw(getpass.getpass().encode(),bcrypt.gensalt()).decode())"
# `viewer.users` in joshua.yaml says who may sign in; an id that is not a key
# there cannot sign in, whatever this holds. Leave a person out to keep them
# signed out. The viewer starts only with `viewer.enabled: true` and
# `docker compose --profile viewer up`, and it listens on 127.0.0.1:8082.
#VIEWER_PASSWORDS=alex=$2b$12$replace-with-a-real-hash

# --- Memory (in-core RAG) ---------------------------------------------------
# Where core keeps the embedding model (about 65 MB). Compose mounts a volume
# at the default, so core downloads the model once instead of on every start.
# The directory must be writable for uid 1000. When it is not, core logs a
# warning and uses a temporary directory, and downloads the model on each
# start. Do not put it under /data/inbox: channels deletes anything there
# older than one hour.
#MEMORY_EMBED_CACHE_DIR=/home/app/.cache/fastembed

# Read-only token for the optional `memos` memory source. Set it only when
# `memory.sources.memos` is configured in joshua.yaml. Leave unset otherwise.
#MEMOS_TOKEN=

# --- Channel credentials ---------------------------------------------------
# Telegram bot token from BotFather. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=

# BlueBubbles server password for the iMessage bridge.
BLUEBUBBLES_PASSWORD=

# Shared secret in the iMessage webhook path.
IMESSAGE_WEBHOOK_SECRET=
