# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# uv and ruff caches
.uv/
.uv-cache/
.ruff_cache/

# Coverage
.coverage
coverage.xml

# Secrets and local config. Anchored to the repo root.
#
# The suffix wildcards cover a copy, which is how a secret gets committed: a
# name like `.env.backup` matches no exact rule, so `git add -A` takes it.
# `.env.example` carries no value and stays tracked.
.env*
!.env.example
/joshua.yaml*

# Data volume
/data/

# Tool artifacts
*.db
*.log
